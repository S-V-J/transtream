DJANGO_SECRET_KEY=replace-with-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
REDIS_URL=redis://127.0.0.1:6379/0

# FFmpeg / Audio Normalization (Phase 3)
FFMPEG_BIN=ffmpeg
FFMPEG_TIMEOUT=300
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# Silero VAD Speech Segmentation (Phase 4)
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=500
VAD_SPEECH_PAD_MS=30

# ─── Faster-Whisper Transcription (Phase 5) ──────────────────────────
# These are read in settings.py now, so editing them here changes behaviour.
# Before commit 95e47a4+1 they were read only by their services, with code-side
# fallbacks, and this file was documentation rather than config.
#
# WHISPER_MODEL_SIZE is the accuracy lever and it is not free: tiny (39M params)
# renders English content words well and domain proper nouns badly - on this
# machine "Kamailio" arrives as "KMLU" and "Terraform" as "telephone". base is
# roughly 2x the decode cost, small roughly 6x. Only tiny is in the Hugging Face
# hub cache by default, so a larger value is a download, not an edit; run
# scripts/compare_whisper_sizes.py to see what a size actually buys on your audio.
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Leave empty to auto-detect (the historical behaviour). Set it when you know the
# language: detection is a guess, and it guessed "id" for a Hindi utterance on
# this machine, which returned romanized noise. One code per deployment.
WHISPER_LANGUAGE=

# ─── Live preview (Phase 5.5) ────────────────────────────────────────
# Frames between rolling-preview runs; <= 0 disables the preview entirely.
LIVE_TRANSCRIBE_EVERY_CHUNKS=30
STUDIO_STATS_EVERY_CHUNKS=20

# ─── Upload ingest (Phase 7) ─────────────────────────────────────────
UPLOAD_MAX_BYTES=104857600
# 120, not 10. A limit of 10 throttles legitimate polling within ~15 s: a
# 180 s poll loop at 10 produced 27 requests and 2 stalls; at 120 the same
# loop produced 79 requests and 0 stalls, and 120/min still stops credential
# stuffing, which needs hundreds per second. This file said 10 while
# settings.py defaulted to 120 and the README documented 120, so a fresh clone
# that copied it reinstated the stalls commit 0926812 measured away - and it
# failed selectively on long takes, which is the worst shape: fine in a demo,
# broken on real work. Keep all three in agreement.
UPLOAD_RATE_LIMIT_PER_MINUTE=120

# ─── Background worker + recovery (Phase 6b) ─────────────────────────
# All six are read in settings.py now. Types matter: WORKER_POLL_INTERVAL is a
# float (the worker wraps it in float()), the rest are ints, and a malformed
# value fails loudly at import rather than silently reverting to a default.
WHISPER_MAX_CONCURRENT=1
WORKER_POLL_INTERVAL=2.0
WORKER_LEASE_DURATION=120
WORKER_HEARTBEAT_INTERVAL=30
WORKER_POLL_BATCH=5
RECOVERY_ORPHAN_MAX_AGE=3600
# The one knob in this file that does NOT go through settings.py: tsworker.py
# reads it directly from os.environ before importing ctranslate2, because it has
# to pin OMP_NUM_THREADS=1 before the library spawns its pool. It works today.
WHISPER_DETERMINISTIC=0

# ─── Hugging Face Hub ────────────────────────────────────────────────
# Leave empty (or delete the line) until one successful run has populated the
# model cache. Setting it to 1 sets HF_HUB_OFFLINE=1, which drops the 0.5-1.1 s
# revision round trip from every cold Whisper load but makes a fresh clone fail
# instead of fetching the ~75 MB tiny weights. Read in settings.py, not by the
# services.
HF_OFFLINE=
HF_TOKEN=
