#!/usr/bin/env bash
set -euo pipefail

# ─── TranStream CLI — Robust Dynamic Port Edition ───────────────────────────
#
#   transtream start             Redis if needed → Daphne → the queue worker
#   transtream start --no-worker App only (uploads queue until a worker runs)
#   transtream stop              Stop Daphne, worker, Redis - only what it started
#   transtream restart           Stop → start (flags pass through)
#   transtream status            Port, process/unit state, bindings, auto-run, worker
#   transtream logs [worker]     Tail app+redis+worker, or just the worker
#   transtream enable            Install BOTH systemd user services (app + worker)
#   transtream disable           Remove both
#   transtream help              Show help
#
# Rules:
#   • NEVER kills a process it did not start.
#   • Default preferred port: 8000; scans upward if busy; chosen port persisted.
#   • Uses systemd user transient service when available, setsid/nohup otherwise.
#   • No auto-run by default.
#   • Refuses to start on an unmigrated database, and names the migrate command.
#   • The worker follows the REDIS ownership pattern, not the Daphne one: a human
#     may already be running one (the A/B harness, or a terminal), so a foreign
#     worker is DETECTED AND REPORTED, never signalled. Killing it would break the
#     rule above and would make the harness's abort-if-alive meaningless.
#
# HEREDOC POLICY, stated because it cost a draft: this file may contain heredocs
# only where the body is a systemd unit or the help text - i.e. only `EOF`, only
# at column 0, and balanced. Program logic that used to be embedded as
# `python - <<'PYEOF'` lives in scripts/ as a real file (check_migrations.py),
# where it gets a py_compile gate and a selftest. A nested heredoc has no opener
# that fails loudly when its body is dropped in a paste; a missing file does.
# ─────────────────────────────────────────────────────────────────────────────

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

VENV_DIR="$PROJECT_DIR/venv"
BACKEND_DIR="$PROJECT_DIR/backend"
LOG_DIR="$PROJECT_DIR/logs"
CHECK_MIGRATIONS="$PROJECT_DIR/scripts/check_migrations.py"

PID_FILE="$LOG_DIR/daphne.pid"
REDIS_PID_FILE="$LOG_DIR/redis.pid"
PORT_FILE="$LOG_DIR/transtream.port"
UNIT_FILE="$LOG_DIR/daphne.unit"

# ─── worker identity files ──────────────────────────────────────────────────
# Deliberately disjoint from the app's, so stop cannot signal the wrong unit and
# status can report both independently. Tiering note for the append-only gate:
# *.pid and *.unit are MUTABLE POINTERS (this script deletes them on a failed
# start, exactly as it already deletes daphne.unit); tsworker.out and worker.log
# are ARTIFACTS and are only ever appended to.
WORKER_PID_FILE="$LOG_DIR/tsworker.pid"
WORKER_UNIT_FILE="$LOG_DIR/tsworker.unit"
WORKER_OUT_FILE="$LOG_DIR/tsworker.out"

PREFERRED_PORT="${TRANSTREAM_PORT:-8000}"
APP_HOST="${TRANSTREAM_HOST:-127.0.0.1}"
REDIS_PORT="${TRANSTREAM_REDIS_PORT:-6379}"

# ─── worker opt-out ─────────────────────────────────────────────────────────
# Default ON, because without a consumer an upload is accepted, persisted, queued
# and never processed - the README's own "Terminal 2: the worker. Without it,
# uploads stay QUEUED forever". TRANSTREAM_WORKER=0 is the scripted form,
# --no-worker the interactive one. The A/B harness needs it: it pkills
# `manage.py tsworker` (ab_warmup_first_take.py:609) and aborts if any worker is
# alive at start, so a measurement run must be able to say "app only".
START_WORKER="${TRANSTREAM_WORKER:-1}"

APP_UNIT_PREFIX="transtream-app"
WORKER_UNIT_PREFIX="transtream-worker"
WORKER_SERVICE_NAME="transtream-worker"
SERVICE_NAME="transtream"
USER_SERVICE_DIR="$HOME/.config/systemd/user"
USER_SERVICE_FILE="$USER_SERVICE_DIR/${SERVICE_NAME}.service"
WORKER_SERVICE_FILE="$USER_SERVICE_DIR/${WORKER_SERVICE_NAME}.service"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}[TranStream]${NC} $*"; }
ok()    { echo -e "${GREEN}[OK]${NC} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
err()   { echo -e "${RED}[ERROR]${NC} $*" >&2; }

ensure_dirs() {
    mkdir -p "$LOG_DIR"
}

port_in_use() {
    python3 -c "
import socket, sys
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(0.3)
r = s.connect_ex(('127.0.0.1', int(sys.argv[1])))
s.close()
sys.exit(0 if r == 0 else 1)
" "$1" 2>/dev/null
}

find_free_port() {
    local start="$1"
    local port="$start"
    local limit=$((start + 200))

    while [ "$port" -lt "$limit" ]; do
        if ! port_in_use "$port"; then
            echo "$port"
            return 0
        fi
        port=$((port + 1))
    done

    return 1
}

resolve_port() {
    if [ -f "$PORT_FILE" ]; then
        local saved
        saved=$(cat "$PORT_FILE" 2>/dev/null || echo "")

        if [[ "$saved" =~ ^[0-9]+$ ]]; then
            if ! port_in_use "$saved"; then
                echo "$saved"
                return 0
            fi

            warn "Saved port $saved is now occupied. Scanning for a new free port..."
        fi
    fi

    local found
    found=$(find_free_port "$PREFERRED_PORT") || {
        err "No free port found in range $PREFERRED_PORT–$((PREFERRED_PORT + 200))."
        exit 1
    }

    echo "$found"
}

csrf_origins_for_port() {
    local port="$1"
    local origins="http://localhost:${port},http://127.0.0.1:${port},http://[::1]:${port}"

    if [ "$APP_HOST" != "127.0.0.1" ] && [ "$APP_HOST" != "localhost" ] && [ "$APP_HOST" != "0.0.0.0" ]; then
        origins="${origins},http://${APP_HOST}:${port}"
    fi

    echo "$origins"
}

has_systemd_user() {
    command -v systemctl >/dev/null 2>&1 &&
    command -v systemd-run >/dev/null 2>&1 &&
    systemctl --user show-environment >/dev/null 2>&1
}

redis_is_running() {
    redis-cli -p "$REDIS_PORT" ping >/dev/null 2>&1
}

start_redis_if_needed() {
    if redis_is_running; then
        ok "Redis already running on port $REDIS_PORT"
        return 0
    fi

    info "Starting Redis on port $REDIS_PORT..."

    redis-server \
        --daemonize yes \
        --port "$REDIS_PORT" \
        --bind 127.0.0.1 \
        --dir "$LOG_DIR" \
        --logfile "$LOG_DIR/redis.log" \
        --pidfile "$REDIS_PID_FILE" \
        --save "" \
        --appendonly no

    sleep 1

    if redis_is_running; then
        ok "Redis started (PID: $(cat "$REDIS_PID_FILE" 2>/dev/null || echo '?'))"
    else
        err "Failed to start Redis. Check $LOG_DIR/redis.log"
        exit 1
    fi
}

stop_redis_if_we_started() {
    if [ -f "$REDIS_PID_FILE" ]; then
        local pid
        pid=$(cat "$REDIS_PID_FILE")

        if kill -0 "$pid" 2>/dev/null; then
            info "Stopping Redis (PID: $pid)..."
            kill "$pid" 2>/dev/null || true
            sleep 1
            ok "Redis stopped"
        fi

        rm -f "$REDIS_PID_FILE"
    else
        warn "Redis was not started by this script. Leaving it alone."
    fi
}

# ─── start-path guard: refuse on an unmigrated database ─────────────────────
# WHY A REFUSAL AND NOT AN AUTOMATIC MIGRATE. `migrate` writes to db.sqlite3. A
# CLI that silently mutates a database the operator did not ask it to touch is the
# same category of surprise as signalling a process it did not start, so the rule
# is the same: name the exact command and stop.
#
# WHY IT CALLS A FILE. The first draft embedded the probe as an inline heredoc;
# the body was dropped in a paste and bash -n caught an unterminated document.
# See scripts/check_migrations.py's docstring for the full account.
#
# WHY IT BRANCHES ON A TOKEN. `local out; out=$(...)` under `set -e` would abort
# the script on a non-zero probe exit, so the status is captured with `|| rc=$?`,
# which makes the compound succeed and leaves rc holding the real value. The
# branch then reads the first word of stdout - the channel that carries the
# answer - and never greps a traceback.
require_migrations_applied() {
    if [ ! -f "$CHECK_MIGRATIONS" ]; then
        err "Missing $CHECK_MIGRATIONS - the start guard cannot run without it."
        exit 1
    fi

    local out rc=0
    out=$("$VENV_DIR/bin/python" "$CHECK_MIGRATIONS" 2>&1) || rc=$?

    case "${out%% *}" in
        APPLIED)
            if [ "$rc" = "0" ]; then
                return 0
            fi
            ;;
        PENDING)
            err "Unapplied migrations: ${out#PENDING: }"
            err "The studio page and the queue worker both need these tables; starting"
            err "them now yields a 500 page and a worker that dies in its recovery sweep."
            err "Run: (cd $BACKEND_DIR && $VENV_DIR/bin/python manage.py migrate)"
            exit 1
            ;;
        DEPS_MISSING)
            err "Dependencies are not installed in $VENV_DIR (${out#DEPS_MISSING: })"
            err "Run: $VENV_DIR/bin/pip install -r $PROJECT_DIR/requirements.txt"
            exit 1
            ;;
        ERROR)
            err "Could not inspect migrations: ${out#ERROR: }"
            exit 1
            ;;
    esac

    err "check_migrations.py gave an unrecognised answer (rc=$rc): ${out:-<empty output>}"
    printf '%s\n' "$out" | tail -n 4 >&2
    exit 1
}

# ─── the queue worker ───────────────────────────────────────────────────────
# Without this process an upload is accepted, persisted, queued and never
# processed - a correct UI reporting a missing operator action. This makes one
# command satisfy the README line that has said so since Phase 6b.
worker_foreign_running() {
    pgrep -f "manage.py tsworker" >/dev/null 2>&1
}

worker_we_started() {
    [ -f "$WORKER_PID_FILE" ] || [ -f "$WORKER_UNIT_FILE" ]
}

start_worker() {
    # Foreign worker: report and leave it alone. This is the redis pattern, and it
    # is what keeps `transtream stop` honest - it can only stop what it recorded.
    if worker_foreign_running && ! worker_we_started; then
        warn "A tsworker is already running that this script did not start."
        warn "Leaving it alone; uploads are being served by that process."
        pgrep -af "manage.py tsworker" | sed 's/^/    /' >&2 || true
        return 0
    fi

    if [ ! -x "$VENV_DIR/bin/python" ]; then
        err "Python not found at $VENV_DIR/bin/python"
        err "Activate venv and install requirements first."
        return 1
    fi

    info "Starting the queue worker (uploads are not processed without it)..."

    # TS_WARMUP_MODELS is set HERE, on the launch line, and deliberately NOT in
    # .env: README:381 records that AppConfig.ready() also runs in Daphne and in
    # every one-off command, and a .env flag cannot tell them apart. The measured
    # trade is ~2.6-3.8 s once at startup against ~2.1-2.4 s of worker time off
    # every user's first take (A/B runs #3 and #4, worker clock).
    if has_systemd_user; then
        local unit
        unit="${WORKER_UNIT_PREFIX}-$(date +%s)-$$"
        echo "$unit" > "$WORKER_UNIT_FILE"

        systemd-run --user --quiet \
            --unit="$unit" \
            --working-directory="$BACKEND_DIR" \
            --setenv=PYTHONUNBUFFERED=1 \
            --setenv=DJANGO_SETTINGS_MODULE=transtream.settings \
            --setenv=TS_WARMUP_MODELS=1 \
            --property=StandardOutput=append:"$WORKER_OUT_FILE" \
            --property=StandardError=append:"$WORKER_OUT_FILE" \
            "$VENV_DIR/bin/python" manage.py tsworker --verbose

        sleep 3

        if systemctl --user is-active --quiet "$unit"; then
            ok "Worker started as systemd user unit $unit"
            return 0
        fi

        err "Worker systemd unit failed to stay active."
        err "Recent journal:"
        journalctl --user -u "$unit" -n 40 --no-pager >&2 || true
        rm -f "$WORKER_UNIT_FILE"
        return 1
    fi

    warn "systemd user session not available. Using setsid/nohup fallback for the worker."

    # The $! below is the real worker pid ONLY BECAUSE this script runs
    # non-interactively: setsid(1) forks when its caller is already a process-group
    # leader, and in an interactive shell a backgrounded job is one, so $! would be
    # a parent that exits immediately and the check below would report failure on a
    # healthy worker. As a script, job control is off, setsid does not fork, and $!
    # is the process we then signal. The same condition holds for the Daphne
    # fallback below. Recorded here because it is invisible to bash -n and to every
    # test that has ever passed.
    if command -v setsid >/dev/null 2>&1; then
        ( cd "$BACKEND_DIR" && setsid nohup "$VENV_DIR/bin/python" manage.py tsworker --verbose \
            </dev/null >> "$WORKER_OUT_FILE" 2>&1 & echo $! ) > "$WORKER_PID_FILE.tmp"
    else
        ( cd "$BACKEND_DIR" && nohup "$VENV_DIR/bin/python" manage.py tsworker --verbose \
            </dev/null >> "$WORKER_OUT_FILE" 2>&1 & echo $! ) > "$WORKER_PID_FILE.tmp"
    fi
    mv "$WORKER_PID_FILE.tmp" "$WORKER_PID_FILE"

    local pid
    pid=$(cat "$WORKER_PID_FILE")
    disown "$pid" 2>/dev/null || true

    sleep 3

    if kill -0 "$pid" 2>/dev/null; then
        ok "Worker started (PID: $pid)"
        return 0
    fi

    # Degrade to a warning rather than a false failure: if the recorded pid is gone
    # but a tsworker of ours is verifiably running, the process is fine and only the
    # bookkeeping is stale. Reporting "failed" here would send the operator to tail
    # a log that says everything is healthy - the worst kind of wrong diagnosis.
    if worker_foreign_running; then
        warn "Worker pid $pid is not addressable, but a tsworker IS running."
        warn "Treating the worker as up; ownership bookkeeping may be stale."
        pgrep -af "manage.py tsworker" | sed 's/^/    /' >&2 || true
        return 0
    fi

    err "Worker fallback process failed to start."
    err "Recent log:"
    tail -n 30 "$WORKER_OUT_FILE" >&2 || true
    rm -f "$WORKER_PID_FILE"
    return 1
}

stop_worker_if_we_started() {
    # Mirror of stop_redis_if_we_started: act only on what we recorded, and say so
    # out loud when we did not.
    if has_systemd_user && [ -f "$WORKER_UNIT_FILE" ]; then
        local unit
        unit=$(cat "$WORKER_UNIT_FILE" 2>/dev/null || echo "")

        if [ -n "$unit" ]; then
            info "Stopping worker systemd user unit: $unit"
            systemctl --user stop "$unit" >/dev/null 2>&1 || true
        fi

        rm -f "$WORKER_UNIT_FILE"
    fi

    if has_systemd_user; then
        systemctl --user stop "$WORKER_SERVICE_NAME" >/dev/null 2>&1 || true
    fi

    if [ -f "$WORKER_PID_FILE" ]; then
        local pid
        pid=$(cat "$WORKER_PID_FILE")

        if kill -0 "$pid" 2>/dev/null; then
            info "Stopping fallback worker (PID: $pid)..."
            kill "$pid" 2>/dev/null || true
            sleep 2

            if kill -0 "$pid" 2>/dev/null; then
                warn "Force killing fallback worker (PID: $pid)..."
                kill -9 "$pid" 2>/dev/null || true
            fi

            ok "Fallback worker stopped"
        fi

        rm -f "$WORKER_PID_FILE"
    elif ! worker_foreign_running; then
        info "No worker was started by this script."
    else
        warn "A tsworker is running that this script did not start. Leaving it alone."
    fi
}

fallback_pid_running() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE")
        kill -0 "$pid" 2>/dev/null && return 0
    fi

    return 1
}

write_persistent_unit() {
    local port="$1"
    local origins
    origins=$(csrf_origins_for_port "$port")

    mkdir -p "$USER_SERVICE_DIR"

    cat > "$USER_SERVICE_FILE" <<EOF
[Unit]
Description=TranStream ASGI Application
After=network.target

[Service]
Type=simple
WorkingDirectory=$BACKEND_DIR
ExecStart=$VENV_DIR/bin/daphne -b $APP_HOST -p $port transtream.asgi:application
Restart=on-failure
RestartSec=5
StandardOutput=append:$LOG_DIR/daphne.log
StandardError=append:$LOG_DIR/daphne-error.log
Environment=PYTHONUNBUFFERED=1
Environment=DJANGO_SETTINGS_MODULE=transtream.settings
Environment="DJANGO_CSRF_TRUSTED_ORIGINS=${origins}"

[Install]
WantedBy=default.target
EOF
}

# The persistent worker unit, written in the same command as the app's, because a
# half-enabled auto-run is its own false affordance: without it, `transtream
# enable` yields a server that comes up after every reboot with no queue consumer,
# which is the stuck-upload state made permanent.
#
# NO Restart= here, unlike the app unit, and the reason is specific: the A/B
# harness pkills `manage.py tsworker` (ab_warmup_first_take.py:609) and aborts if
# any worker is alive at start. A respawning persistent worker would come back
# five seconds after that pkill and make the NEXT measurement run refuse to start,
# blaming the operator's terminal. A measurement tool and an auto-running consumer
# are in genuine tension; the resolution is that auto-run must not fight the
# harness, because the harness produced the numbers the README quotes.
write_persistent_worker_unit() {
    mkdir -p "$USER_SERVICE_DIR"

    cat > "$WORKER_SERVICE_FILE" <<EOF
[Unit]
Description=TranStream Queue Worker
After=network.target

[Service]
Type=simple
WorkingDirectory=$BACKEND_DIR
ExecStart=$VENV_DIR/bin/python manage.py tsworker --verbose
StandardOutput=append:$WORKER_OUT_FILE
StandardError=append:$WORKER_OUT_FILE
Environment=PYTHONUNBUFFERED=1
Environment=DJANGO_SETTINGS_MODULE=transtream.settings
Environment=TS_WARMUP_MODELS=1

[Install]
WantedBy=default.target
EOF
}

start_daphne() {
    if [ ! -f "$BACKEND_DIR/manage.py" ]; then
        err "backend/manage.py not found. Create the Django project first."
        exit 1
    fi

    if [ ! -x "$VENV_DIR/bin/daphne" ]; then
        err "Daphne executable not found at $VENV_DIR/bin/daphne"
        err "Activate venv and install requirements first."
        exit 1
    fi

    ensure_dirs

    local port
    port=$(resolve_port)
    echo "$port" > "$PORT_FILE"

    local origins
    origins=$(csrf_origins_for_port "$port")

    if has_systemd_user; then
        local unit
        unit="${APP_UNIT_PREFIX}-$(date +%s)-$$"
        echo "$unit" > "$UNIT_FILE"

        info "Starting Daphne as systemd user unit: $unit"
        info "Access: http://$APP_HOST:$port/"

        systemd-run --user --quiet \
            --unit="$unit" \
            --working-directory="$BACKEND_DIR" \
            --setenv=PYTHONUNBUFFERED=1 \
            --setenv=DJANGO_SETTINGS_MODULE=transtream.settings \
            --setenv="DJANGO_CSRF_TRUSTED_ORIGINS=${origins}" \
            --property=StandardOutput=append:"$LOG_DIR/daphne.log" \
            --property=StandardError=append:"$LOG_DIR/daphne-error.log" \
            "$VENV_DIR/bin/daphne" \
                -b "$APP_HOST" \
                -p "$port" \
                transtream.asgi:application

        sleep 2

        if systemctl --user is-active --quiet "$unit"; then
            ok "Daphne started under systemd user unit $unit"
            info "Use: transtream status"
            info "Use: transtream logs"
        else
            err "Daphne systemd unit failed to stay active."
            err "Recent journal:"
            journalctl --user -u "$unit" -n 80 --no-pager >&2 || true

            rm -f "$UNIT_FILE" "$PORT_FILE"
            exit 1
        fi
    else
        warn "systemd user session not available. Using setsid/nohup fallback."

        info "Starting Daphne fallback process on http://$APP_HOST:$port ..."

        cd "$BACKEND_DIR"

        # $! is the real pid only because this runs non-interactively; see the
        # identical note in start_worker.
        if command -v setsid >/dev/null 2>&1; then
            setsid nohup "$VENV_DIR/bin/daphne" \
                -b "$APP_HOST" \
                -p "$port" \
                transtream.asgi:application \
                </dev/null \
                >> "$LOG_DIR/daphne.log" \
                2>&1 &
        else
            nohup "$VENV_DIR/bin/daphne" \
                -b "$APP_HOST" \
                -p "$port" \
                transtream.asgi:application \
                </dev/null \
                >> "$LOG_DIR/daphne.log" \
                2>&1 &
        fi

        local pid=$!
        echo "$pid" > "$PID_FILE"

        disown "$pid" 2>/dev/null || true

        sleep 2

        if kill -0 "$pid" 2>/dev/null; then
            ok "Daphne started (PID: $pid)"
            info "Access: http://localhost:$port/"
        else
            err "Daphne fallback process failed to start."
            err "Recent log:"
            tail -n 50 "$LOG_DIR/daphne.log" >&2 || true

            rm -f "$PID_FILE" "$PORT_FILE"
            exit 1
        fi
    fi
}

stop_daphne() {
    ensure_dirs

    # Stop transient systemd unit if recorded.
    if has_systemd_user && [ -f "$UNIT_FILE" ]; then
        local unit
        unit=$(cat "$UNIT_FILE" 2>/dev/null || echo "")

        if [ -n "$unit" ]; then
            info "Stopping systemd user unit: $unit"
            systemctl --user stop "$unit" >/dev/null 2>&1 || true
        fi

        rm -f "$UNIT_FILE"
    fi

    # Stop persistent systemd service if present.
    if has_systemd_user; then
        systemctl --user stop "$SERVICE_NAME" >/dev/null 2>&1 || true
    fi

    # Stop fallback PID if present.
    if fallback_pid_running; then
        local pid
        pid=$(cat "$PID_FILE")

        info "Stopping fallback Daphne process (PID: $pid)..."
        kill "$pid" 2>/dev/null || true
        sleep 2

        if kill -0 "$pid" 2>/dev/null; then
            warn "Force killing fallback Daphne process (PID: $pid)..."
            kill -9 "$pid" 2>/dev/null || true
        fi

        rm -f "$PID_FILE"
        ok "Fallback Daphne stopped"
    else
        rm -f "$PID_FILE"
    fi
}

cmd_start() {
    local with_worker="$START_WORKER"
    local a
    for a in "$@"; do
        case "$a" in
            --no-worker) with_worker=0 ;;
            --worker)    with_worker=1 ;;
            *) err "Unknown start flag: $a"; cmd_help; exit 1 ;;
        esac
    done

    ensure_dirs
    require_migrations_applied
    start_redis_if_needed
    start_daphne

    # Worker LAST, and its failure is a WARN, not a teardown: if Daphne is up and
    # the worker is not, the microphone path still works. Killing a running server
    # to protest a missing queue consumer would trade a partial failure for a
    # total one. The final message then says which half is running.
    local worker_ok=1
    if [ "$with_worker" = "1" ]; then
        if ! start_worker; then
            worker_ok=0
        fi
    else
        info "Worker skipped (--no-worker / TRANSTREAM_WORKER=0)."
        info "Uploads will queue at 'Queued' until one is running."
    fi

    echo ""
    if [ "$worker_ok" = "1" ] && [ "$with_worker" = "1" ]; then
        ok "TranStream is running: app, queue worker, and Redis."
        info "Microphone takes and file uploads both work now; no second terminal needed."
    elif [ "$with_worker" = "1" ]; then
        warn "TranStream is PARTIALLY running: the app is up, the worker is not."
        warn "Microphone recording works. Uploads will sit at 'Queued (waiting for worker)'."
        warn "Retry:   transtream stop && transtream start"
        warn "Inspect: tail -n 40 $WORKER_OUT_FILE"
    else
        ok "TranStream app is running (worker deliberately not started)."
    fi
    info "Logs: $LOG_DIR/"
}

cmd_stop() {
    stop_daphne
    stop_worker_if_we_started
    stop_redis_if_we_started

    echo ""
    ok "TranStream stopped."
}

cmd_restart() {
    cmd_stop
    sleep 1
    cmd_start "$@"
}

cmd_status() {
    ensure_dirs

    local port="?"
    [ -f "$PORT_FILE" ] && port=$(cat "$PORT_FILE")

    echo "─────────────────────────────────────────"
    echo " TranStream Status"
    echo "─────────────────────────────────────────"
    info "Project dir : $PROJECT_DIR"
    info "App URL     : http://$APP_HOST:$port/"
    info "Redis port  : $REDIS_PORT"
    echo ""

    if redis_is_running; then
        ok "Redis  : RUNNING on port $REDIS_PORT"
    else
        err "Redis  : NOT RUNNING"
    fi

    local daphne_running=false

    if has_systemd_user && [ -f "$UNIT_FILE" ]; then
        local unit
        unit=$(cat "$UNIT_FILE" 2>/dev/null || echo "")

        if [ -n "$unit" ]; then
            if systemctl --user is-active --quiet "$unit"; then
                daphne_running=true
                local main_pid
                main_pid=$(systemctl --user show -p MainPID --value "$unit" 2>/dev/null || echo "?")

                ok "Daphne : RUNNING as systemd user unit $unit"
                info "MainPID: $main_pid"
            else
                warn "Daphne : systemd user unit $unit is not active"
            fi
        fi
    fi

    if has_systemd_user; then
        if systemctl --user is-active --quiet "$SERVICE_NAME"; then
            daphne_running=true
            ok "Daphne : RUNNING as persistent systemd service $SERVICE_NAME"
        fi
    fi

    if fallback_pid_running; then
        daphne_running=true
        ok "Daphne : RUNNING as fallback process (PID: $(cat "$PID_FILE"))"
    fi

    if [ "$daphne_running" = false ]; then
        warn "Daphne : NOT RUNNING"
    fi

    # The worker line, with its consequence spelled out rather than implied: an
    # operator who reads "Worker: NOT RUNNING" and knows the UI looks fine is the
    # exact person who needs to be told that uploads are the affected half.
    local worker_running=false
    if has_systemd_user && [ -f "$WORKER_UNIT_FILE" ]; then
        local wunit
        wunit=$(cat "$WORKER_UNIT_FILE" 2>/dev/null || echo "")
        if [ -n "$wunit" ] && systemctl --user is-active --quiet "$wunit"; then
            worker_running=true
            ok "Worker : RUNNING as systemd user unit $wunit"
        fi
    fi
    if has_systemd_user && systemctl --user is-active --quiet "$WORKER_SERVICE_NAME" 2>/dev/null; then
        worker_running=true
        ok "Worker : RUNNING as persistent systemd service $WORKER_SERVICE_NAME"
    fi
    if [ -f "$WORKER_PID_FILE" ] && kill -0 "$(cat "$WORKER_PID_FILE")" 2>/dev/null; then
        worker_running=true
        ok "Worker : RUNNING as fallback process (PID: $(cat "$WORKER_PID_FILE"))"
    fi
    if [ "$worker_running" = false ] && worker_foreign_running; then
        worker_running=true
        ok "Worker : RUNNING, but not started by this script (foreign process - left alone)"
        pgrep -af "manage.py tsworker" | sed 's/^/    /' || true
    fi
    if [ "$worker_running" = false ]; then
        warn "Worker : NOT RUNNING - uploads will queue at 'Queued' and never process"
        warn "         (microphone takes are unaffected)"
    fi

    echo ""
    info "Port $port binding:"
    ss -ltnp 2>/dev/null | grep ":${port} " || echo "  (none)"

    info "Port $REDIS_PORT binding:"
    ss -ltnp 2>/dev/null | grep ":${REDIS_PORT} " || echo "  (none)"

    echo ""
    if has_systemd_user; then
        if systemctl --user is-enabled "$SERVICE_NAME" 2>/dev/null; then
            ok "Auto-run app service    : ENABLED"
        else
            info "Auto-run app service    : DISABLED (default)"
        fi
        # The two units can disagree, and status must say so: a worker-less
        # auto-run is the stuck-upload state, permanently, and silently across a
        # reboot - which is the failure mode this whole change exists to remove.
        if systemctl --user is-enabled "$WORKER_SERVICE_NAME" 2>/dev/null; then
            ok "Auto-run worker service : ENABLED"
        else
            warn "Auto-run worker service : DISABLED - after a reboot, uploads will stall"
        fi
    else
        info "systemd user session: NOT AVAILABLE"
    fi

    echo "─────────────────────────────────────────"
}

cmd_logs() {
    ensure_dirs

    if has_systemd_user && [ -f "$UNIT_FILE" ]; then
        local unit
        unit=$(cat "$UNIT_FILE" 2>/dev/null || echo "")

        if [ -n "$unit" ]; then
            if systemctl --user is-active --quiet "$unit"; then
                info "Following systemd journal for unit: $unit"
                journalctl --user -u "$unit" -f
            else
                info "Showing recent systemd journal for inactive unit: $unit"
                journalctl --user -u "$unit" -n 120 --no-pager
            fi

            return 0
        fi
    fi

    if has_systemd_user && systemctl --user is-active --quiet "$SERVICE_NAME"; then
        info "Following systemd journal for persistent service: $SERVICE_NAME"
        journalctl --user -u "$SERVICE_NAME" -f
        return 0
    fi

    # `transtream logs worker` follows only the worker, so an operator debugging a
    # stuck upload is not scrolling past Daphne traffic.
    if [ "${1:-}" = "worker" ]; then
        if has_systemd_user && [ -f "$WORKER_UNIT_FILE" ]; then
            local wunit
            wunit=$(cat "$WORKER_UNIT_FILE" 2>/dev/null || echo "")
            if [ -n "$wunit" ] && systemctl --user is-active --quiet "$wunit"; then
                info "Following systemd journal for worker unit: $wunit"
                journalctl --user -u "$wunit" -f
                return 0
            fi
        fi
        touch "$WORKER_OUT_FILE" "$LOG_DIR/worker.log"
        info "Tailing $WORKER_OUT_FILE and $LOG_DIR/worker.log (Ctrl+C to stop)..."
        tail -f "$WORKER_OUT_FILE" "$LOG_DIR/worker.log"
        return 0
    fi

    touch "$LOG_DIR/daphne.log" "$LOG_DIR/redis.log" "$WORKER_OUT_FILE"

    info "Tailing log files (Ctrl+C to stop)..."
    tail -f "$LOG_DIR/daphne.log" "$LOG_DIR/redis.log" "$WORKER_OUT_FILE"
}

cmd_enable() {
    if ! has_systemd_user; then
        err "systemd user session is not available."
        err "Cannot enable auto-run."
        exit 1
    fi

    ensure_dirs

    local port
    if [ -f "$PORT_FILE" ]; then
        port=$(cat "$PORT_FILE")
    else
        port=$(find_free_port "$PREFERRED_PORT") || {
            err "No free port found in range $PREFERRED_PORT–$((PREFERRED_PORT + 200))."
            exit 1
        }
        echo "$port" > "$PORT_FILE"
    fi

    write_persistent_unit "$port"
    write_persistent_worker_unit

    systemctl --user daemon-reload
    systemctl --user enable "$SERVICE_NAME"
    systemctl --user enable "$WORKER_SERVICE_NAME"

    ok "Auto-run ENABLED on port $port (app + worker)."
    info "TranStream and its queue worker will start on login."
    info "Start now manually: systemctl --user start $SERVICE_NAME $WORKER_SERVICE_NAME"
    info "Disable later:      transtream disable"
}

cmd_disable() {
    if ! has_systemd_user; then
        warn "systemd user session is not available."
        rm -f "$USER_SERVICE_FILE" "$WORKER_SERVICE_FILE"
        ok "Auto-run DISABLED."
        return 0
    fi

    info "Disabling auto-run..."

    systemctl --user disable "$SERVICE_NAME" 2>/dev/null || true
    systemctl --user stop "$SERVICE_NAME" 2>/dev/null || true
    systemctl --user disable "$WORKER_SERVICE_NAME" 2>/dev/null || true
    systemctl --user stop "$WORKER_SERVICE_NAME" 2>/dev/null || true
    rm -f "$USER_SERVICE_FILE" "$WORKER_SERVICE_FILE"
    systemctl --user daemon-reload

    ok "Auto-run DISABLED. TranStream will NOT start automatically."
}

cmd_help() {
    cat <<EOF
TranStream CLI — Robust Dynamic Port Edition

Usage:
  transtream <command>

Commands:
  start                 Redis if needed -> Daphne -> the queue worker
  start --no-worker     App only; uploads queue until a worker runs
  stop                  Stop Daphne, worker and Redis - only what it started
  restart               Stop -> start (flags pass through)
  status                Port, process/unit state, bindings, auto-run, worker
  logs [worker]         Tail app+redis+worker, or just the worker
  enable                Install BOTH systemd user services (app + worker)
  disable               Remove both
  help                  Show this help message

Port behavior:
  • Preferred port: $PREFERRED_PORT
  • Override: TRANSTREAM_PORT=9000 transtream start
  • If busy, scans upward for first free port.
  • Selected port saved to: $PORT_FILE

Host behavior:
  • Default bind: $APP_HOST
  • Override: TRANSTREAM_HOST=0.0.0.0 transtream start

Redis behavior:
  • Uses existing Redis if port $REDIS_PORT responds.
  • Starts local Redis only if not already running.
  • Stops Redis only if this script started it.

Worker behavior:
  • Started by default; uploads are not processed without one.
  • Opt out: transtream start --no-worker, or TRANSTREAM_WORKER=0 transtream start
  • TS_WARMUP_MODELS=1 is set on the launch line, never in .env, because
    AppConfig.ready() also runs in Daphne and in one-off commands.
  • Stops only if this script started it; a foreign worker is reported, not killed.
  • The A/B harness (scripts/ab_warmup_first_take.py) aborts if any worker is
    alive at start and pkills one at the end - run 'transtream stop' first, or
    use --no-worker.

Process behavior:
  • Uses systemd user transient service when available.
  • Falls back to setsid/nohup when systemd user is unavailable.
  • NEVER kills a process it did not start.
  • Refuses to start on an unmigrated database, and prints the migrate command.
  • The migration probe is scripts/check_migrations.py - a file, not an inline
    heredoc, so it can be compiled and self-tested.

Auto-run:
  • Disabled by default.
  • enable installs BOTH the app and the worker unit; a worker-less auto-run
    would leave uploads stalled after every reboot.
  • Use: transtream enable / transtream disable

Project dir : $PROJECT_DIR
Script path : $SCRIPT_PATH
Log dir     : $LOG_DIR
EOF
}

case "${1:-help}" in
    start)   shift; cmd_start "$@" ;;
    stop)    cmd_stop ;;
    restart) shift; cmd_restart "$@" ;;
    status)  cmd_status ;;
    logs)    shift; cmd_logs "$@" ;;
    enable)  cmd_enable ;;
    disable) cmd_disable ;;
    help|--help|-h) cmd_help ;;
    *)
        err "Unknown command: $1"
        cmd_help
        exit 1
        ;;
esac
