#!/usr/bin/env bash
set -euo pipefail

# ─── TranStream CLI Management Script ───────────────────────────────────────
# Usage:
#   transtream start       Start Redis (if needed) + Daphne ASGI server
#   transtream stop        Stop Daphne (and Redis if we started it)
#   transtream restart     Stop then start
#   transtream status      Show running processes and port bindings
#   transtream logs        Tail application logs
#   transtream enable      Install systemd user service for auto-start
#   transtream disable     Remove systemd user service
#   transtream help        Show this help
#
# Default behavior:
#   NO auto-run. The app only runs when you explicitly start it.
# ─────────────────────────────────────────────────────────────────────────────

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

VENV_DIR="$PROJECT_DIR/venv"
BACKEND_DIR="$PROJECT_DIR/backend"
LOG_DIR="$PROJECT_DIR/logs"
PID_FILE="$LOG_DIR/daphne.pid"
REDIS_PID_FILE="$LOG_DIR/redis.pid"

REDIS_PORT="${TRANSTREAM_REDIS_PORT:-6379}"
APP_HOST="${TRANSTREAM_HOST:-127.0.0.1}"
APP_PORT="${TRANSTREAM_PORT:-8000}"

SERVICE_NAME="transtream"
USER_SERVICE_DIR="$HOME/.config/systemd/user"
USER_SERVICE_FILE="$USER_SERVICE_DIR/${SERVICE_NAME}.service"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}[TranStream]${NC} $*"; }
ok()    { echo -e "${GREEN}[OK]${NC} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
err()   { echo -e "${RED}[ERROR]${NC} $*" >&2; }

ensure_dirs() {
    mkdir -p "$LOG_DIR"
}

activate_venv() {
    if [ ! -d "$VENV_DIR" ]; then
        err "Virtual environment not found at $VENV_DIR"
        err "Create it with: python3 -m venv venv"
        exit 1
    fi

    # shellcheck disable=SC1091
    source "$VENV_DIR/bin/activate"
}

redis_is_running() {
    redis-cli -p "$REDIS_PORT" ping >/dev/null 2>&1
}

start_redis_if_needed() {
    if redis_is_running; then
        ok "Redis already running on port $REDIS_PORT"
        return 0
    fi

    info "Starting Redis on port $REDIS_PORT..."

    redis-server \
        --daemonize yes \
        --port "$REDIS_PORT" \
        --bind 127.0.0.1 \
        --dir "$LOG_DIR" \
        --logfile "$LOG_DIR/redis.log" \
        --pidfile "$REDIS_PID_FILE" \
        --save "" \
        --appendonly no

    sleep 1

    if redis_is_running; then
        ok "Redis started (PID: $(cat "$REDIS_PID_FILE" 2>/dev/null || echo '?'))"
    else
        err "Failed to start Redis. Check $LOG_DIR/redis.log"
        exit 1
    fi
}

stop_redis_if_we_started() {
    if [ -f "$REDIS_PID_FILE" ]; then
        local pid
        pid=$(cat "$REDIS_PID_FILE")

        if kill -0 "$pid" 2>/dev/null; then
            info "Stopping Redis (PID: $pid)..."
            kill "$pid" 2>/dev/null || true
            sleep 1
            ok "Redis stopped"
        fi

        rm -f "$REDIS_PID_FILE"
    else
        warn "Redis was not started by this script. Leaving it alone."
    fi
}

daphne_is_running() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE")
        kill -0 "$pid" 2>/dev/null && return 0
    fi

    return 1
}

start_daphne() {
    if daphne_is_running; then
        warn "Daphne already running (PID: $(cat "$PID_FILE"))"
        return 0
    fi

    if [ ! -f "$BACKEND_DIR/manage.py" ]; then
        err "backend/manage.py not found at $BACKEND_DIR/manage.py"
        err "Create the Django project before starting TranStream."
        exit 1
    fi

    activate_venv
    ensure_dirs

    info "Starting Daphne ASGI server on http://$APP_HOST:$APP_PORT ..."

    cd "$BACKEND_DIR"

    nohup daphne -b "$APP_HOST" -p "$APP_PORT" \
        transtream.asgi:application \
        >> "$LOG_DIR/daphne.log" 2>&1 &

    local pid=$!
    echo "$pid" > "$PID_FILE"

    sleep 2

    if kill -0 "$pid" 2>/dev/null; then
        ok "Daphne started (PID: $pid)"
        info "Access: http://localhost:$APP_PORT/"
    else
        err "Daphne failed to start. Check $LOG_DIR/daphne.log"
        tail -n 30 "$LOG_DIR/daphne.log" >&2 || true
        rm -f "$PID_FILE"
        exit 1
    fi
}

stop_daphne() {
    if systemctl --user is-active --quiet "$SERVICE_NAME" 2>/dev/null; then
        info "Stopping systemd user service $SERVICE_NAME..."
        systemctl --user stop "$SERVICE_NAME" || true
    fi

    if ! daphne_is_running; then
        warn "Daphne is not running."
        rm -f "$PID_FILE"
        return 0
    fi

    local pid
    pid=$(cat "$PID_FILE")

    info "Stopping Daphne (PID: $pid)..."
    kill "$pid" 2>/dev/null || true
    sleep 2

    if kill -0 "$pid" 2>/dev/null; then
        warn "Force killing Daphne..."
        kill -9 "$pid" 2>/dev/null || true
    fi

    rm -f "$PID_FILE"
    ok "Daphne stopped"
}

cmd_start() {
    ensure_dirs
    start_redis_if_needed
    start_daphne

    echo ""
    ok "TranStream is running."
    info "Logs: $LOG_DIR/"
}

cmd_stop() {
    stop_daphne
    stop_redis_if_we_started

    echo ""
    ok "TranStream stopped."
}

cmd_restart() {
    cmd_stop
    sleep 1
    cmd_start
}

cmd_status() {
    echo "─────────────────────────────────────────"
    echo " TranStream Status"
    echo "─────────────────────────────────────────"
    info "Project dir: $PROJECT_DIR"
    info "App URL:     http://$APP_HOST:$APP_PORT/"
    info "Redis port:  $REDIS_PORT"

    echo ""

    if redis_is_running; then
        ok "Redis: RUNNING on port $REDIS_PORT"
    else
        err "Redis: NOT RUNNING"
    fi

    if daphne_is_running; then
        ok "Daphne: RUNNING (PID: $(cat "$PID_FILE"))"
    else
        warn "Daphne: NOT RUNNING"
    fi

    echo ""
    info "Port $APP_PORT binding:"
    ss -ltnp 2>/dev/null | grep ":$APP_PORT " || echo "  (none)"

    info "Port $REDIS_PORT binding:"
    ss -ltnp 2>/dev/null | grep ":$REDIS_PORT " || echo "  (none)"

    echo ""
    if systemctl --user is-enabled "$SERVICE_NAME" 2>/dev/null; then
        ok "Auto-run systemd user service: ENABLED"
    else
        info "Auto-run systemd user service: DISABLED (default)"
    fi

    echo "─────────────────────────────────────────"
}

cmd_logs() {
    ensure_dirs
    touch "$LOG_DIR/daphne.log" "$LOG_DIR/redis.log"

    info "Tailing logs (Ctrl+C to stop)..."
    tail -f "$LOG_DIR/daphne.log" "$LOG_DIR/redis.log"
}

cmd_enable() {
    info "Enabling auto-run via systemd user service..."

    mkdir -p "$USER_SERVICE_DIR"

    cat > "$USER_SERVICE_FILE" <<EOF
[Unit]
Description=TranStream ASGI Application
After=network.target

[Service]
Type=simple
WorkingDirectory=$BACKEND_DIR
ExecStart=$VENV_DIR/bin/daphne -b $APP_HOST -p $APP_PORT transtream.asgi:application
Restart=on-failure
RestartSec=5
StandardOutput=append:$LOG_DIR/daphne.log
StandardError=append:$LOG_DIR/daphne-error.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
EOF

    systemctl --user daemon-reload
    systemctl --user enable "$SERVICE_NAME"

    ok "Auto-run ENABLED. TranStream will start on login."
    info "To start now: systemctl --user start $SERVICE_NAME"
    info "To disable:   transtream disable"
}

cmd_disable() {
    info "Disabling auto-run..."

    systemctl --user disable "$SERVICE_NAME" 2>/dev/null || true
    systemctl --user stop "$SERVICE_NAME" 2>/dev/null || true
    rm -f "$USER_SERVICE_FILE"
    systemctl --user daemon-reload

    ok "Auto-run DISABLED. TranStream will NOT start automatically."
}

cmd_help() {
    cat <<EOF
TranStream CLI — Application Management

Usage:
  transtream <command>

Commands:
  start       Start Redis (if needed) + Daphne ASGI server
  stop        Stop Daphne (and Redis if we started it)
  restart     Stop then start
  status      Show running processes, ports, and auto-run state
  logs        Tail application log files
  enable      Install systemd user service for auto-start on login
  disable     Remove systemd user service (default: no auto-run)
  help        Show this help message

Default behavior:
  • NO auto-run. The app only runs when you explicitly start it.
  • Redis is started only if not already running on port $REDIS_PORT.
  • Daphne binds to http://$APP_HOST:$APP_PORT/

Optional environment overrides:
  TRANSTREAM_PORT=8080 transtream start
  TRANSTREAM_HOST=0.0.0.0 transtream start
  TRANSTREAM_REDIS_PORT=6379 transtream start

Project directory: $PROJECT_DIR
Script path:       $SCRIPT_PATH
Log directory:     $LOG_DIR
EOF
}

case "${1:-help}" in
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    restart) cmd_restart ;;
    status)  cmd_status ;;
    logs)    cmd_logs ;;
    enable)  cmd_enable ;;
    disable) cmd_disable ;;
    help|--help|-h) cmd_help ;;
    *)
        err "Unknown command: $1"
        cmd_help
        exit 1
        ;;
esac
